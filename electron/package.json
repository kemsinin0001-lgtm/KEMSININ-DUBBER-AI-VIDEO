{
  "name": "kemsinin-dubber",
  "version": "2.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64 --publish always",
    "build:portable": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.kemsinin.dubber",
    "productName": "KEMSININ DUBBER",
    "publish": [
      {
        "provider": "github",
        "owner": "YOUR_GITHUB_USERNAME",
        "repo": "kemsinin-dubber",
        "releaseType": "release"
      }
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "updater.js",
      "../ui/**/*",
      "../backend/**/*"
    ],
    "win": {
      "target": ["nsis"],
      "icon": "build/icon.ico",
      "publish": ["github"]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "KEMSININ DUBBER",
      "deleteAppDataOnUninstall": false
    }
  },
  "dependencies": {
    "electron-updater": "^6.3.9",
    "electron-log": "^5.2.0",
    "electron-store": "^8.2.0"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
